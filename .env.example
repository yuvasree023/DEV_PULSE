# ==============================================================================
# DEVPULSE CONFIGURATION SPECIFICATION (.env.example)
# ==============================================================================
# Frontend: Deployed on Vercel
# Backend:  Deployed on Render (FastAPI + PostgreSQL + Celery/Background workers)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Project Settings)
# ------------------------------------------------------------------------------
# VITE_API_URL: Public URL of your deployed Python FastAPI backend on Render.
# Example: https://devpulse-backend.onrender.com
# For local development with Vite dev server: leave empty (Vite dev proxy forwards /api to localhost:8000)
VITE_API_URL="https://your-devpulse-backend.onrender.com"


# ------------------------------------------------------------------------------
# 2. BACKEND DATABASE CONFIGURATION (Configure in Render Environment)
# ------------------------------------------------------------------------------
# DATABASE_URL: PostgreSQL connection string from Render PostgreSQL instance.
# Example: postgresql://devpulse_user:password@dpg-xxxxxx.render.com/devpulse_db
# (Fallback: Defaults to sqlite:///./devpulse.db for seamless zero-setup local dev)
DATABASE_URL="postgresql://devpulse_user:password@dpg-xxxxxx.render.com/devpulse_db"


# ------------------------------------------------------------------------------
# 3. GITHUB OAUTH APPLICATION (Configure in Render Environment)
# ------------------------------------------------------------------------------
# Steps to create GitHub OAuth App:
#   1. Go to https://github.com/settings/developers -> New OAuth App
#   2. Application name: DevPulse
#   3. Homepage URL: https://dev-pulse-lhnv-nine.vercel.app
#   4. Authorization callback URL: https://dev-pulse-lhnv-nine.vercel.app/login
GITHUB_CLIENT_ID="Iv23xxxxxxxxxxxxxx"
GITHUB_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GITHUB_REDIRECT_URI="https://dev-pulse-lhnv-nine.vercel.app/login"


# ------------------------------------------------------------------------------
# 4. SECURITY & CRYPTOGRAPHY (Configure in Render Environment)
# ------------------------------------------------------------------------------
# JWT_SECRET: Strong random secret used to sign session JWT tokens
JWT_SECRET="devpulse-jwt-production-secret-change-in-production-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ENCRYPTION_SECRET_KEY: Key used to symmetrically encrypt stored GitHub PATs and integration keys
ENCRYPTION_SECRET_KEY="devpulse-aes-token-encryption-secret-2026"


# ------------------------------------------------------------------------------
# 5. AI EXPLANATION & ML ENGINES (Configure in Render Environment)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Used for grounded Gemini natural-language metric summaries (/api/explain)
GEMINI_API_KEY="AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"


# ------------------------------------------------------------------------------
# 6. CORS & ENVIRONMENT (Configure in Render Environment)
# ------------------------------------------------------------------------------
# CORS_ORIGINS: Comma-separated list of allowed frontend origins
CORS_ORIGINS="https://dev-pulse-lhnv-nine.vercel.app,http://localhost:5173,http://localhost:3000"

# FRONTEND_URL: Canonical URL of the frontend application
FRONTEND_URL="https://dev-pulse-lhnv-nine.vercel.app"

# ENVIRONMENT: Deployment mode ('development' or 'production')
ENVIRONMENT="production"

# LOG_LEVEL: Logging verbosity ('INFO', 'DEBUG', 'WARNING', 'ERROR')
LOG_LEVEL="INFO"
