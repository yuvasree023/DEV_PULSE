# ==============================================================================
# DEVPULSE BACKEND CONFIGURATION SPECIFICATION (.env.example)
# ==============================================================================
# Deployed on Render (FastAPI + PostgreSQL + Celery/Background tasks)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Render PostgreSQL Internal or External Connection URL
# Format: postgresql://username:password@dpg-xxxxxx.render.com/dbname
# (If omitted locally, defaults automatically to sqlite:///./devpulse.db)
DATABASE_URL="postgresql://devpulse_user:password@dpg-xxxxxx.render.com/devpulse_db"


# ------------------------------------------------------------------------------
# 2. GITHUB OAUTH APPLICATION CREDENTIALS
# ------------------------------------------------------------------------------
# Create in GitHub: Profile -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Homepage URL: https://dev-pulse-lhnv-nine.vercel.app
# Authorization callback URL: https://dev-pulse-lhnv-nine.vercel.app/login
GITHUB_CLIENT_ID="Iv23xxxxxxxxxxxxxx"
GITHUB_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GITHUB_REDIRECT_URI="https://dev-pulse-lhnv-nine.vercel.app/login"


# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHY SECRETS
# ------------------------------------------------------------------------------
# Secret for signing user session JWT tokens
JWT_SECRET="devpulse-jwt-production-secret-change-in-production-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Secret for AES symmetric encryption of stored GitHub PATs and tool keys
ENCRYPTION_SECRET_KEY="devpulse-aes-token-encryption-secret-2026"


# ------------------------------------------------------------------------------
# 4. AI EXPLANATION KEY
# ------------------------------------------------------------------------------
# Google Gemini API key for grounded narrative metric explanation (/api/explain)
GEMINI_API_KEY="AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"


# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME & CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (Vercel production + localhost)
CORS_ORIGINS="https://dev-pulse-lhnv-nine.vercel.app,http://localhost:5173,http://localhost:3000"

# Canonical URL of frontend application
FRONTEND_URL="https://dev-pulse-lhnv-nine.vercel.app"

# Environment: 'production' or 'development'
ENVIRONMENT="production"

# Logging level: 'INFO', 'DEBUG', 'WARNING', 'ERROR'
LOG_LEVEL="INFO"
